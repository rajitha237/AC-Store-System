APP_NAME=AC Store Management System
APP_VERSION=0.2.0

# development | production
ENVIRONMENT=development
DEBUG=true

API_V1_PREFIX=/api/v1

# Comma-separated browser origins allowed to call the API.
# Replace with the real frontend origin in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local development database.
# Replace with the deployment database URL in production.
DATABASE_URL=sqlite+aiosqlite:///./ac_store.db

# Development/test convenience.
# Production deployments must set both to false.
STARTUP_SEED_ENABLED=true
STARTUP_CREATE_ADMIN_ENABLED=true

# REQUIRED:
# Generate a unique high-entropy value for every deployment.
JWT_SECRET_KEY=REPLACE_WITH_SECURE_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Initial bootstrap administrator.
# These values are used only when the initial administrator
# does not already exist.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@acstore.local
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_STRONG_UNIQUE_PASSWORD
INITIAL_ADMIN_FULL_NAME=System Administrator
